# =============================================================================
# JeevanPath AI — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# All keys are optional — sensible defaults are applied by Settings class.
# Keys are case-insensitive (JP_STT_MODEL_SIZE == jp_stt_model_size).
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME="JeevanPath AI"
APP_VERSION="0.2.0"
ENVIRONMENT="development"       # development | staging | production
DEBUG=false

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
# Async DSN — used by FastAPI / SQLAlchemy async sessions
DATABASE_URL="postgresql+asyncpg://jeevanpath:jeevanpath@localhost:5432/jeevanpath"
# Sync DSN — used by Alembic migrations only
DATABASE_SYNC_URL="postgresql+psycopg2://jeevanpath:jeevanpath@localhost:5432/jeevanpath"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO_SQL=false

# ---------------------------------------------------------------------------
# Device (leave empty for auto-detection: CUDA if available, else CPU)
# ---------------------------------------------------------------------------
DEVICE=                         # "cuda" | "cuda:0" | "cpu" | "auto" | ""

# ---------------------------------------------------------------------------
# STT — Whisper (faster-whisper)
# ---------------------------------------------------------------------------
STT_ENGINE="faster_whisper"     # faster_whisper | fake
STT_MODEL_SIZE="large-v3"       # tiny | base | small | medium | large-v2 | large-v3
STT_COMPUTE_TYPE=""             # float16 | int8 | "" (auto)
STT_BEAM_SIZE=5
STT_LANGUAGE_DETECTION_THRESHOLD=0.5
STT_NO_SPEECH_THRESHOLD=0.6
STT_CPU_THREADS=4
STT_NUM_WORKERS=1
STT_VAD_MIN_SILENCE_MS=300

# ---------------------------------------------------------------------------
# LLM — Local instruction-following model
# ---------------------------------------------------------------------------
LLM_ENGINE="hf_local"           # hf_local | fake
LLM_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.9
LLM_LOAD_IN_8BIT=false
LLM_LOAD_IN_4BIT=false         # Requires bitsandbytes>=0.41

# ---------------------------------------------------------------------------
# Embedding Model
# ---------------------------------------------------------------------------
EMBEDDING_ENGINE="sentence_transformer"   # sentence_transformer | fake
EMBEDDING_MODEL_NAME="ai4bharat/indic-sentence-bert-nli-v1"
EMBEDDING_DIM=768               # Must match the model's actual output dimension
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# TTS — Text-to-Speech
# ---------------------------------------------------------------------------
TTS_ENGINE="mms_tts"            # mms_tts | fake
TTS_MODEL_PREFIX="facebook/mms-tts"
TTS_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# Audio Upload
# ---------------------------------------------------------------------------
AUDIO_TEMP_DIR="temp_audio"
AUDIO_MAX_SIZE_BYTES=26214400   # 25 MB

# ---------------------------------------------------------------------------
# Concurrency
# ---------------------------------------------------------------------------
THREADPOOL_MAX_WORKERS=4

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL="INFO"                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT="json"               # json | console

# ---------------------------------------------------------------------------
# CORS (comma-separated list of allowed origins)
# ---------------------------------------------------------------------------
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]'

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH="/metrics"
